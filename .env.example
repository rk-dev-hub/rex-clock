# このファイルをコピーして .env を作る:  cp .env.example .env
# 値はすべてダミー。ローカル開発はそのまま動く。実運用では必ず差し替えること。

# PostgreSQL 接続文字列。docker compose の既定値に一致。
DATABASE_URL="postgresql://rexclock:rexclock@localhost:5432/rexclock?schema=public"

# ポート 5432 / 8080 が他のプロジェクトと競合する場合はここを変更し、
# 上の DATABASE_URL のポートも合わせる（docker compose がこの .env を自動で読む）。
# DB_PORT=5433
# ADMINER_PORT=8081

# docker compose --profile app up（お試し起動）でアプリを公開するポート。3000 が競合する場合に変更する。
# APP_PORT=3001

# Auth.js セッション署名鍵。次のコマンドで生成した値に置き換える:
#   openssl rand -base64 32
AUTH_SECRET="dummy-dummy-dummy-dummy-dummy-dummy-32ch"
AUTH_URL="http://localhost:3000"

# 表示・集計のタイムゾーン（基本は固定）
APP_TIMEZONE="Asia/Tokyo"

# seed が作成する初期管理者。初回ログイン時にパスワード変更を求められる。
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="ChangeMe123!"

# CSV 既定エンコーディング:  utf8 | utf8-bom | shift_jis
CSV_ENCODING="utf8-bom"
